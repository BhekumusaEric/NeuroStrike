# NeuroStrike Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key for LLM functionality
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace API Key
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Shodan API Key
SHODAN_API_KEY=your_shodan_api_key_here

# VirusTotal API Key
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Metasploit RPC Configuration (optional)
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASSWORD=password

# Network Configuration
# Comma-separated list of IP addresses or ranges to exclude from scanning
EXCLUDED_IPS=127.0.0.1,10.0.0.1

# Safe Mode Configuration
# Set to false to enable actual exploit execution (USE WITH CAUTION)
SAFE_MODE=true

# Auto Remediation Configuration
# Set to true to enable automatic application of fixes (USE WITH CAUTION)
AUTO_REMEDIATE=false
